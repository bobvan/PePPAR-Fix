diff --git a/Firmware/GNSSDO_Firmware/Begin.ino b/Firmware/GNSSDO_Firmware/Begin.ino
index cdb0bd3..b542da9 100644
--- a/Firmware/GNSSDO_Firmware/Begin.ino
+++ b/Firmware/GNSSDO_Firmware/Begin.ino
@@ -661,12 +661,42 @@ void updateTCXO(double bias_ms)
 // This function updates the TCXO using the specified bias and P&I terms
 void updateTCXO(double bias_ms, double P, double I)
 {
+    // Hard safety interlock: when an external host owns the oscillator, the
+    // internal discipline loop must never touch it. The state machine also
+    // holds STATE_GNSS_EXTERNAL_CONTROL in this case, so this is belt-and-
+    // suspenders - but keep it here so no future caller can slip past. See
+    // ExternalControl.ino.
+    if (externalControl)
+        return;
+
     if (online.tcxo)
     {
         myTCXO->setFrequencyByBiasMillis(bias_ms, P, I);
     }
 }
 
+// Rebuild the oscillator driver so its PI integrator restarts from the
+// oscillator's *current* control word. Used when resuming internal discipline
+// after external control ends (watchdog bark or an explicit "$E,0"): the
+// external host may have moved the oscillator a long way, so we must not slam
+// it back to a stale integral. Rebuilding the driver is how the firmware has
+// always reset the integrator (see the commented reinit blocks in States.ino);
+// with the STP3593LF integrator now held in the driver object rather than in
+// function statics, the rebuild resets it cleanly for every oscillator type.
+void resetTcxoIntegrator()
+{
+    if (!online.tcxo)
+        return;
+
+    if (myTCXO != nullptr)
+    {
+        delete myTCXO;
+        myTCXO = nullptr;
+    }
+
+    beginTCXO(i2cTCXO, settings.printDebugMessages);
+}
+
 // This function tells the TCXO to save its control value - if supported
 void saveTCXO()
 {
diff --git a/Firmware/GNSSDO_Firmware/ExternalControl.ino b/Firmware/GNSSDO_Firmware/ExternalControl.ino
new file mode 100644
index 0000000..32ae1b3
--- /dev/null
+++ b/Firmware/GNSSDO_Firmware/ExternalControl.ino
@@ -0,0 +1,201 @@
+// External oscillator control
+// ============================
+//
+// This adds a small, line-based command channel to the ESP32 console so an
+// external host can discipline the oscillator directly, instead of the built-in
+// GNSSDO loop. It was written for PePPAR-Fix (a GNSS-disciplined precision clock
+// project) but is deliberately generic.
+//
+// The channel is the ordinary console, so it works over USB *and* over the
+// mosaic-T TCP backdoor (Operation menu -> "TCP Server (IPS1)"): connect a TCP
+// socket to the mosaic-T's IP on the configured port and you are talking to
+// this parser.
+//
+// A command is a single line beginning with '$'. updateSerial() (menuMain.ino)
+// routes '$' lines here; every other keystroke still opens the interactive menu.
+//
+//   $E,1            Enable external control  (suspend internal discipline)
+//   $E,0            Disable external control (resume internal discipline)
+//   $W,<word>       Write the oscillator frequency control word (absolute).
+//                   Implicitly enables external control and re-arms the
+//                   watchdog. This is the discipline command.
+//   $T,<seconds>    Set the external-control watchdog timeout (1..600 s)
+//   $R              Report status (see below)
+//
+// Replies are one line each and echo the command letter:
+//   $W,OK,<word>                    control word written; <word> read back
+//   $E,OK,<0|1>                     external control state after the command
+//   $T,OK,<seconds>                 watchdog timeout set
+//   $R,<ext>,<word>,<bias_s>,<state>,<watchdog_s>,<since_ms>
+//   $<letter>,ERR[,<reason>]        command rejected
+//
+// Fail-safe: once external control is open, a watchdog (updateSystemState() in
+// States.ino) requires a discipline command ($W) - or an explicit $E,1 - at
+// least every externalControlWatchdog_s seconds. If the host goes quiet the
+// firmware resets its servo integrator and resumes internal discipline. The
+// external-control flag is never persisted, so a power cycle also returns the
+// unit to internal discipline. PPS keeps running throughout.
+//
+// The control word is oscillator-specific:
+//   STP3593LF (GNSSDO+ / SXT-D OCXO): 20-bit unsigned, LSB = 8e-13 (0.8 ppt)
+//   SiT5811   (alternate OCXO):       39-bit signed
+//   SiT5358   (GNSSDO / SXT DCTCXO):  26-bit signed
+// getFrequencyControlWord() (see $R) returns the current word so the host can
+// seed its own servo before taking over.
+
+// Read the remainder of a command line (the leading '$' is already consumed)
+// into buf. Terminates on CR/LF, on buffer-full, or on a short idle timeout so
+// a partial line can never wedge the console. Returns the number of characters
+// captured.
+static size_t readExternalControlLine(char *buf, size_t bufLen)
+{
+    size_t spot = 0;
+    unsigned long lastChar_ms = millis();
+
+    while ((millis() - lastChar_ms) < 250) // Ample for a line already in flight
+    {
+        while (systemAvailable() > 0)
+        {
+            int c = systemRead();
+            lastChar_ms = millis();
+
+            if ((c == '\r') || (c == '\n'))
+            {
+                buf[spot] = '\0';
+                return spot;
+            }
+
+            if (spot < (bufLen - 1))
+                buf[spot++] = (char)c;
+            // If the line overflows we keep draining until CR/LF but stop storing
+        }
+    }
+
+    buf[spot] = '\0';
+    return spot;
+}
+
+// Parse a signed integer from s, skipping leading separators (space, comma,
+// tab). Sets *ok false if no digits were found.
+static long long parseExternalControlInt(const char *s, bool *ok)
+{
+    while ((*s == ' ') || (*s == ',') || (*s == '\t'))
+        s++;
+
+    char *end = nullptr;
+    long long value = strtoll(s, &end, 10);
+    *ok = (end != s);
+    return value;
+}
+
+// Handle one '$'-prefixed command line. Called from updateSerial() once the
+// leading '$' has been read.
+void parseExternalControlCommand()
+{
+    char line[48];
+    readExternalControlLine(line, sizeof(line));
+
+    // First non-space character is the command letter
+    char *p = line;
+    while (*p == ' ')
+        p++;
+    char cmd = *p++;
+
+    switch (cmd)
+    {
+    // ---- Write control word (the discipline command) ----------------------
+    case 'W':
+    case 'w': {
+        if (!online.tcxo)
+        {
+            systemPrintln("$W,ERR,NO_OSC");
+            break;
+        }
+
+        bool ok = false;
+        long long word = parseExternalControlInt(p, &ok);
+        if (!ok)
+        {
+            systemPrintln("$W,ERR,NO_VALUE");
+            break;
+        }
+
+        if (!externalControl)
+            beginExternalControl(); // Implicitly open the loop on the first write
+
+        externalControlLastCommand_ms = millis(); // Re-arm the watchdog
+
+        myTCXO->setFrequencyControlWord((int64_t)word);
+
+        systemPrintf("$W,OK,%lld\r\n", (long long)getFrequencyControlWord());
+        break;
+    }
+
+    // ---- Enable / disable external control --------------------------------
+    case 'E':
+    case 'e': {
+        bool ok = false;
+        long long enable = parseExternalControlInt(p, &ok);
+        if (!ok)
+        {
+            systemPrintln("$E,ERR,NO_VALUE");
+            break;
+        }
+
+        if (enable)
+        {
+            if (!online.tcxo)
+            {
+                systemPrintln("$E,ERR,NO_OSC");
+                break;
+            }
+            if (!externalControl)
+                beginExternalControl();
+            else
+                externalControlLastCommand_ms = millis(); // Re-arm
+            systemPrintln("$E,OK,1");
+        }
+        else
+        {
+            if (externalControl)
+                endExternalControl();
+            systemPrintln("$E,OK,0");
+        }
+        break;
+    }
+
+    // ---- Set the watchdog timeout -----------------------------------------
+    case 'T':
+    case 't': {
+        bool ok = false;
+        long long seconds = parseExternalControlInt(p, &ok);
+        if (!ok || (seconds < 1) || (seconds > 600))
+        {
+            systemPrintln("$T,ERR,RANGE");
+            break;
+        }
+        settings.externalControlWatchdog_s = (int)seconds; // Recorded to NVM at next settings save
+        systemPrintf("$T,OK,%d\r\n", settings.externalControlWatchdog_s);
+        break;
+    }
+
+    // ---- Report status ----------------------------------------------------
+    case 'R':
+    case 'r': {
+        char stateName[30];
+        uint32_t since_ms = externalControl ? (millis() - externalControlLastCommand_ms) : 0;
+        systemPrintf("$R,%d,%lld,%.6e,%s,%d,%lu\r\n",
+                     externalControl ? 1 : 0,
+                     (long long)getFrequencyControlWord(),
+                     tcxoClockBias_ms / 1000.0, // clock bias in seconds
+                     getState(systemState, stateName),
+                     settings.externalControlWatchdog_s,
+                     (unsigned long)since_ms);
+        break;
+    }
+
+    default:
+        systemPrintln("$,ERR,UNKNOWN");
+        break;
+    }
+}
