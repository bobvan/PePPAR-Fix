+++ b/Firmware/GNSSDO_Firmware/States.ino
@@ -20,6 +20,18 @@ void updateSystemState()
         lastSystemStateUpdate = millis();
         forceSystemStateUpdate = false;
 
+        // External-control watchdog (see ExternalControl.ino).
+        // If an external host has opened the discipline loop but has stopped
+        // sending discipline commands, fail safe: resume internal discipline.
+        // The external host must re-arm this watchdog with every command.
+        if (externalControl
+            && ((millis() - externalControlLastCommand_ms)
+                > ((uint32_t)settings.externalControlWatchdog_s * 1000UL)))
+        {
+            systemPrintln("External control watchdog expired - resuming internal discipline");
+            endExternalControl();
+        }
+
         // Check to see if any external sources need to change state
         if (newSystemStateRequested == true)
         {
@@ -586,6 +598,28 @@ void updateSystemState()
         }
         break;
 
+        // An external host (e.g. PePPAR-Fix) owns the oscillator.
+        // The internal discipline loop is suspended: we do NOT call updateTCXO
+        // here. We keep the clock-bias telemetry fresh, keep PPS running, and
+        // let the watchdog (top of this function) hand control back if the
+        // external host goes quiet. See ExternalControl.ino.
+        case (STATE_GNSS_EXTERNAL_CONTROL): {
+            if (gnssPVTUpdated) // Wait for PVT to be updated. It contains Error.
+            {
+                gnssPVTUpdated = false;
+
+                updateTCXOClockBias(); // Keep tcxoClockBias_ms fresh for telemetry / the external host
+
+                updateLockLED(); // Update Lock LED based on systemState
+                updateErrorLED();
+
+                // Keep PPS running while the external host disciplines the oscillator
+                if (!ppsStarted && !gnssError && configureGNSSPPS())
+                    ppsStarted = true;
+            }
+        }
+        break;
+
         default: {
             systemPrintf("Unknown state: %d\r\n", systemState);
         }
@@ -594,6 +628,29 @@ void updateSystemState()
     }
 }
 
+// Begin external oscillator control (called from ExternalControl.ino).
+// Suspends internal discipline and hands the oscillator to an external host.
+void beginExternalControl()
+{
+    externalControl = true;
+    externalControlLastCommand_ms = millis();
+    requestChangeState(STATE_GNSS_EXTERNAL_CONTROL);
+}
+
+// End external oscillator control - watchdog bark or an explicit "$E,0".
+// Resets the servo integrator so internal discipline resumes from the
+// oscillator's current control word (the external host may have moved it far),
+// then re-runs frequency locking. PPS is left running throughout.
+void endExternalControl()
+{
+    externalControl = false;
+    externalControlLastCommand_ms = millis();
+    resetTcxoIntegrator(); // Begin.ino - rebuild the driver so the integrator reseeds from the current control word
+    slewing = false;
+    secondsInPhaseLock = 0;
+    requestChangeState(STATE_GNSS_FINETIME);
+}
+
 // System state changes may only occur within main state machine
 // To allow state changes from external sources (ie, Button Tasks) requests can be made
 // Requests are handled at the start of updateSystemState()
