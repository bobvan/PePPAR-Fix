# Observation data and correction products (large, downloadable)
data/

# Host-local state (receiver identity, position, DO characterization).
# Runtime JSON is host-specific; README.md files are checked in so
# lab hosts get directory descriptions on pull.  DO characterization
# migrated from per-host <uid>.json to the per-section <uid>.toml schema
# (do_schema) — those are equally host-local and must be ignored too,
# else do_*_char tools leave untracked files that risk accidental commit.
state/**/*.json
state/**/*.toml
state/**/*.tmp

# Credentials — any ntrip*.conf variant (ntrip-cnes.conf,
# ntrip-whu.conf, …) is gitignored; the *.example templates are
# re-included explicitly.
ntrip*.conf
!ntrip*.conf.example
*.secrets

# Antenna positions — never commit surveyed coords.  Authoritative
# positions live in the (private) timelab repo at timelab/antPos.json;
# runtime positions live in state/receivers/<uid>.json (covered
# above).  This belt-and-suspenders entry catches antPos.json if it
# ever ends up inside this tree by accident.
antPos.json
*-pos.json

# Python
__pycache__/
*.pyc
.venv/

# Editor swap files (vim and friends)
.*.sw[a-z]
*~

# Binary dumps
*.rtcm
*.bin
.claude/

# Host-specific tmux launcher (see convention notes); co-located but not shared.
/tmux-up

# Host-local ARP survey history (runtime state, same class as the *.json/*.toml
# state below — regenerable, not shared).
state/**/*.jsonl

# Regenerable plot outputs — Plotly HTML written by tools/plot_*.py.
# Each inlines plotly.js (~4.9 MB); regenerate locally, don't commit.
# plots/README.md is re-included so the output dir persists on checkout.
plots/*.html
