# Broadcast ephemeris, taken IN-BAND from the BRUX observation stream.
# Not from the BCEP product itself: that is 403 for our account on
# products.igs-ip.net, and TLS-only on the GA caster, which str2str cannot do
# as an input.
#
# Shell-sourced by str2str-relay-exec (NOT a systemd EnvironmentFile), so
# ARGS must be QUOTED and $HOME expands.  '%Y%m%d_%h' is str2str's filename
# template and passes through untouched -- single %, no systemd escaping.
IN=ntrip://igs-ip.net:2101/BRUX00BEL0
CRED=IGS
ARGS="-out ntripc://:2103/BCEP -out file://$HOME/opt/ntrip-relay/logs/bcep_%Y%m%d_%h.rtcm3::T::S=24 -r 30000"

