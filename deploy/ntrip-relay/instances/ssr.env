# SSR corrections — orbit, clock, code bias (phase bias = 0, so no AR).
# IGS-RTS combined.  SSRA00BKG0 was retired 2026-07-22; this is its successor.
#
# Shell-sourced by str2str-relay-exec (NOT a systemd EnvironmentFile), so
# ARGS must be QUOTED and $HOME expands.  '%Y%m%d_%h' is str2str's filename
# template and passes through untouched -- single %, no systemd escaping.
IN=ntrip://products.igs-ip.net:2101/SSRA03IGS0
CRED=PRODUCTS
ARGS="-out ntripc://:2101/SSR -out file://$HOME/opt/ntrip-relay/logs/ssr_%Y%m%d_%h.rtcm3::T::S=24 -r 30000"

