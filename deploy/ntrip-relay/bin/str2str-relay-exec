#!/usr/bin/env bash
# str2str-relay-exec <instance>
#
# Launcher for str2str-relay@<instance>.service.  Composes the str2str command
# from two files and exec's it:
#
#   ~/opt/ntrip-relay/relay.env             credentials, shared, NOT in git
#   ~/opt/ntrip-relay/instances/<i>.env     this stream's IN / CRED / ARGS
#
# WHY A WRAPPER AND NOT A PURE ExecStart.  systemd does NOT recursively expand
# ${VAR} references that appear INSIDE a value loaded from an EnvironmentFile.
# Measured 2026-08-24: with ARGS='-in ntrip://${IGS_USER}:x@h/M ...' and
# ExecStart='... $ARGS', argv[2] arrives as the literal string
# 'ntrip://${IGS_USER}:x@h/M'.  str2str takes credentials only inside the URL,
# so something has to assemble that URL after the credentials are in scope.
# This script is that something.  No eval -- bash indirect expansion (${!name})
# is enough and does not turn a config file into a code-execution surface.
#
# Two systemd behaviours this design DOES rely on, both measured the same day:
#   * an unquoted $ARGS is split at whitespace into separate argv entries
#   * an EnvironmentFile value is NOT specifier-expanded, so '%Y%m%d_%h' is
#     written with SINGLE percent signs here (unit files need '%%')
set -euo pipefail

STR2STR="${STR2STR:-$HOME/bin/str2str}"
ENVDIR="${NTRIP_RELAY_DIR:-$HOME/opt/ntrip-relay}"

inst="${1:?usage: str2str-relay-exec <instance>}"
inst_env="$ENVDIR/instances/${inst}.env"

[[ -r "$ENVDIR/relay.env" ]] || { echo "missing $ENVDIR/relay.env" >&2; exit 78; }
[[ -r "$inst_env" ]]         || { echo "missing $inst_env" >&2; exit 78; }
[[ -x "$STR2STR" ]]          || { echo "missing or non-executable $STR2STR" >&2; exit 78; }

set -a
# shellcheck disable=SC1090
. "$ENVDIR/relay.env"
. "$inst_env"
set +a

: "${IN:?$inst_env must define IN=}"
: "${ARGS:?$inst_env must define ARGS=}"

# CRED names a credential PAIR in relay.env (CRED=IGS -> IGS_USER / IGS_PASS).
# Instances with no upstream auth (e.g. a raw TCP source) simply omit it.
if [[ -n "${CRED:-}" ]]; then
    uvar="${CRED}_USER"; pvar="${CRED}_PASS"
    u="${!uvar-}"; p="${!pvar-}"
    [[ -n "$u" && -n "$p" ]] || {
        echo "CRED=$CRED but ${uvar}/${pvar} are not set in relay.env" >&2; exit 78; }
    # An '@' or ':' in a credential would make the authority ambiguous and
    # str2str would connect somewhere unintended.  Refuse rather than guess.
    case "$u$p" in
        *@*|*:*|*/*) echo "credentials for $CRED contain @, : or / -- str2str takes them raw in the URL, which would be ambiguous.  Rotate to an alphanumeric secret." >&2; exit 78 ;;
    esac
    IN="${IN/:\/\//://$u:$p@}"
fi

# Optional outbound NTRIP-server pushes -- zero or more networks.  Composed here for the same
# reason IN is: the wrapper does not expand ${VAR} inside ARGS, and the password
# must not appear in the instance file (which lives in the repo).
#
# Credentials AND mountpoints live in relay.env, not in the instance file which
# is in the repo: onocoy states its mountpoint is "not public", so it is
# account-identifying even if it is not strictly a secret.
#
# str2str speaks NTRIP v1 for server push -- verified in the binary:
#     SOURCE %s %s          (password, mountpoint)
#     ntrips://[:passwd@]addr[:port]/mntpnt
# There is NO username field, which matches onocoy's own instruction for v1
# devices: "enter the NTRIP username as MOUNTPOINT ... leave the username field
# empty".  Hence the empty user before the colon below.
PUSH_ARG=""
# PUSH_CREDS is a space-separated list of network name-prefixes.  For each, the
# wrapper looks up <P>_HOST, <P>_PUSHMOUNT and <P>_PASS in relay.env and appends
# an NTRIP-server -out.
#
# <P>_PUSHMOUNT means "the string this network wants in the NTRIP v1 MOUNTPOINT
# field", which is NOT the same thing for every network:
#
#   ONOCOY      -> their auto-generated USERNAME (shown as "Credential" on the
#                  station page).  onocoy's own v1 instruction is to put the
#                  username in the mountpoint field and leave username empty.
#   RTKDIRECT   -> their actual MOUNTPOINT.  They issue a separate username,
#                  which NTRIP v1 has no field for and which is therefore unused.
#
# Both work because str2str speaks v1: SOURCE <password> <mountpoint>, no
# username field at all.  Verified against both casters 2026-08-26.
for _P in ${PUSH_CREDS:-}; do
    hv="${_P}_HOST"; mv="${_P}_PUSHMOUNT"; pv="${_P}_PASS"
    h="${!hv-}"; mnt="${!mv-}"; pw="${!pv-}"
    [[ -n "$h" && -n "$mnt" && -n "$pw" ]] || {
        echo "PUSH_CREDS lists $_P but ${hv}/${mv}/${pv} are not all set in relay.env" >&2
        exit 78; }
    case "$pw$mnt" in
        *@*|*:*|*/*) echo "push credentials for $_P contain @, : or / — ambiguous in the URL" >&2; exit 78 ;;
    esac
    # PUSH_FMT: "#rtcm3" makes str2str CONVERT to RTCM3, which requires the
    # input to carry a #format too.  For an instance whose input is already
    # RTCM3 this must be EMPTY -- str2str exits with "specify input format" if
    # only one side names a format, and a needless decode/re-encode would also
    # require -msg to say what to emit.
    PUSH_ARG="$PUSH_ARG -out ntrips://:${pw}@${h}/${mnt}${PUSH_FMT-#rtcm3}"
done

# ARGS is intentionally unquoted: it must word-split into separate arguments.
# Values inside it therefore must not contain whitespace or quotes; check.sh
# enforces that, because a quoted value would reach str2str with the quotes
# still attached.
# shellcheck disable=SC2086
exec "$STR2STR" -in "$IN" $ARGS $PUSH_ARG
