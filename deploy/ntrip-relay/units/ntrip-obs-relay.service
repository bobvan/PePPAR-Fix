[Unit]
Description=NTRIP obs re-caster (Box 2) — PTBB obs+eph -> gt:2102 (obs.ntrip.VanValzah.Com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/home/bob/opt/ntrip-relay/relay.env
ExecStart=/home/bob/bin/str2str -in ntrip://${IGS_USER}:${IGS_PASS}@igs-ip.net:2101/PTBB00DEU0 -out ntripc://:2102/PTBB -out file:///home/bob/opt/ntrip-relay/logs/ptbb_%%Y%%m%%d_%%h.rtcm3::T::S=24 -r 30000
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
