# peppar-fix.service — disciplines the ClockMatrix OCXO (combo servo).
# THE BOOT DEFAULT on a validated OTC/Mini host (Bob 2026-06-25): peppar-fix is
# the default timing service; timebeat is the operator's EXPLICIT choice
# (`systemctl start timebeat` stops this via Conflicts=).  Self-healing:
# Restart=on-failure + the wrapper's own exit-5 relaunch loop; any harder
# failure → reboot → this starts again → re-disciplines (power cycle recovers
# any ClockMatrix state — Bob accepts that risk).  Logs LOCAL + bounded
# (logrotate → gt-nfs); the sshfs mount is never in the hot path.
[Unit]
Description=PePPAR-Fix — discipline the ClockMatrix OCXO (combo servo)
Conflicts=timebeat.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bob
WorkingDirectory=/home/bob/peppar-fix
ExecStartPre=/bin/sleep 3
ExecStart=/bin/bash /home/bob/peppar-fix/scripts/peppar-fix
StandardOutput=append:/home/bob/peppar-fix/data/peppar-fix.log
StandardError=append:/home/bob/peppar-fix/data/peppar-fix.log
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
